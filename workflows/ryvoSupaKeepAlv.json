{
  "updatedAt": "2026-09-03T16:06:17.537Z",
  "createdAt": "2026-09-01T15:08:12.725Z",
  "id": "ryvoSupaKeepAlv",
  "name": "supabase_keepalive",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 4,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "b0000000-0000-4000-8000-000000000001",
      "name": "Daily 04:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -400,
        0
      ],
      "notes": "04:00 Europe/Lisbon (GENERIC_TIMEZONE), one hour after backup.sh at 03:00 so a bad night shows both signals together."
    },
    {
      "parameters": {
        "url": "https://txxkqskhxhwtrhbmwwig.supabase.co/rest/v1/automations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "key"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "PingSupabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -180,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "ryvoSupabaseCred",
          "name": "Ryvo Supabase (service_role)"
        }
      },
      "notes": "onError=continueRegularOutput is load-bearing: a Supabase auto-pause removes the project's DNS record, which is a TRANSPORT error. neverError does not cover those, so without this the node throws and the alert never fires -- for exactly the failure it exists to catch.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// Success path only -- the failure branch notifies then throws.\nconst res = $('PingSupabase').first().json;\nreturn [{ json: { ok: true, statusCode: res.statusCode, checkedAt: new Date().toISOString() } }];\n"
      },
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "AssertReachable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ping-ok",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ka-IsPingOk",
      "name": "IsPingOk",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $env.TWILIO_ACCOUNT_SID }}/Messages.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twilioApi",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "From",
              "value": "={{ $env.TWILIO_WHATSAPP_FROM }}"
            },
            {
              "name": "To",
              "value": "whatsapp:+351933048230"
            },
            {
              "name": "Body",
              "value": "=Ryvo ALERT: Supabase keepalive FAILED ({{ $json.statusCode || 'no response - DNS or connection failure' }}). The platform DB is unreachable, so inbound leads are not being stored. Check the Supabase dashboard for an auto-pause."
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ka-NotifyKeepaliveFailure",
      "name": "NotifyKeepaliveFailure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        140
      ],
      "credentials": {
        "twilioApi": {
          "id": "ryvoTwilioCred",
          "name": "Ryvo Twilio (sandbox)"
        }
      },
      "notes": "Alert target is hardcoded: config.escalate_to lives in the system being monitored.",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// Notify first, THEN throw. Throwing is what makes n8n record a failed\n// execution (the pull signal); the WhatsApp is the push signal. Both, in that\n// order, so a Twilio failure cannot swallow the execution-level alarm.\nconst ping = $('PingSupabase').first().json;\nconst notify = $input.first().json;\nconst notified = notify.statusCode >= 200 && notify.statusCode < 300;\nthrow new Error(\n  'SUPABASE KEEPALIVE FAILED -- platform DB unreachable. statusCode=' + ping.statusCode +\n  '. Operator WhatsApp alert ' + (notified ? 'SENT' : 'ALSO FAILED (' + notify.statusCode + ')') +\n  '. Most likely the free-tier project has auto-paused (7 days idle) or the ' +\n  'service_role key was rotated. Check the Supabase dashboard first.');\n"
      },
      "id": "ka-ThrowKeepaliveFailure",
      "name": "ThrowKeepaliveFailure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        140
      ]
    }
  ],
  "connections": {
    "Daily 04:00": {
      "main": [
        [
          {
            "node": "PingSupabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PingSupabase": {
      "main": [
        [
          {
            "node": "IsPingOk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IsPingOk": {
      "main": [
        [
          {
            "node": "AssertReachable",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "NotifyKeepaliveFailure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "NotifyKeepaliveFailure": {
      "main": [
        [
          {
            "node": "ThrowKeepaliveFailure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
