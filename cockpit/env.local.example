# Ryvo Cockpit — environment
#
# NOTHING in this file may be prefixed NEXT_PUBLIC_ except the two values
# that are genuinely public. The service_role key in particular must never
# reach the browser: see docs/phase-2-checkpoint-e-cockpit-handoff.md §4.

# Public — safe in the browser bundle. The anon key is RLS-gated and RLS is
# deny-by-default on all nine tables, so it can read nothing on its own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. If this ever appears in a client bundle,
# anything in front of the app can read and write every client's leads.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Comma-separated list of addresses allowed to hold a session.
# Anyone can request a magic link for their own address; this is what stops
# them getting past the door. Checked on every request, not only at send time.
COCKPIT_ALLOWED_EMAILS=

# Where magic links come back to. http://localhost:3000 in development,
# the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
