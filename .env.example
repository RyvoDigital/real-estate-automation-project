# =============================================================================
# Ryvo automation platform — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` ON THE SERVER, fill every value, and keep a copy in a password
# manager. NEVER commit the real .env (it is gitignored).
#
# The OPERATOR generates and holds all secret values. Commands shown below are
# run by the operator, not the agent. Placeholder values here are NOT real.
# =============================================================================

# --- Domain ---
# Base domain; n8n is served at n8n.<DOMAIN>
DOMAIN=yourdomain.com

# --- n8n / engine Postgres ---
# CRITICAL: encrypts all credentials stored inside n8n. If lost, every saved
# credential in n8n becomes unrecoverable. Generate once, store in two places.
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# Signs n8n user-management session tokens.
#   openssl rand -hex 24
N8N_JWT_SECRET=

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Strong random password for the engine Postgres role.
#   openssl rand -hex 24
N8N_DB_PASSWORD=

# --- Supabase (EU / Frankfurt — eu-central-1) ---
# From the Supabase project settings. service_role is server-side ONLY; it must
# never reach a browser or a client-side bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used to apply db/migrations/*.sql. The publishable
# and secret API keys go through PostgREST and cannot run DDL, so schema changes
# need this instead.
#   Supabase -> Project Settings -> Database -> Connection string -> Session pooler
# Use the SESSION pooler on port 5432, NOT the transaction pooler on 6543: the
# transaction pooler does not reliably handle multi-statement DDL scripts.
# Percent-encode any of @ : / ? # & % appearing in the password.
SUPABASE_DB_URL=

# --- Anthropic (used by automations + Zero in later phases) ---
ANTHROPIC_API_KEY=

# --- WhatsApp via Twilio Sandbox (Phase 1 channel) ---
# The Meta Cloud API path is blocked (Business Portfolio account disabled and
# appeal denied), so Phase 1 runs on the Twilio Sandbox for WhatsApp. It needs
# no WhatsApp Business Account and no Meta account.
#
# Sandbox setup is ONLY available in the LEGACY console:
#   twilio.com/console/sms/whatsapp/sandbox
#
# NOTE: the sandbox session expires 3 days after joining. If inbound messages
# stop arriving, re-send `join <TWILIO_SANDBOX_KEYWORD>` from the operator's
# WhatsApp before debugging anything else.

# Twilio Console, starts `AC...`. Also sent on every webhook as AccountSid --
# the workflow checks that it matches before doing anything else.
TWILIO_ACCOUNT_SID=

# Twilio Console. This is BOTH the API password AND the key used to compute
# X-Twilio-Signature, so it is what makes inbound webhook verification possible.
# Rotating it invalidates signatures immediately.
TWILIO_AUTH_TOKEN=

# The sandbox sender, WITH the channel prefix: whatsapp:+14155238886
# Stored in clients.whatsapp_number WITHOUT the prefix, as +14155238886.
TWILIO_WHATSAPP_FROM=

# The join code shown in the legacy console, e.g. `join <two-words>`.
TWILIO_SANDBOX_KEYWORD=

# --- WhatsApp via Meta Cloud API (FUTURE — not used in Phase 1) ---
# Kept documented so the migration back to Meta is a config change, not an
# archaeology exercise. When Meta unblocks, only the inbound parse node, the
# signature check and the send node change; everything downstream is
# channel-agnostic. Leave these empty for now.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Google Calendar (Phase 1, Checkpoint C) ---
# The OAuth credential itself is configured by the operator in the n8n UI, not
# here; this is only the target calendar.
GOOGLE_CALENDAR_ID=

# --- Alerting (Checkpoint D1) ------------------------------------------------
# The alert channel deliberately does NOT ride Twilio, Supabase or n8n: it has
# to be able to report that any of them is down. It is a plain HTTPS call from
# cron, with its own credential.
#
# ALERT_EMAIL_TO is a comma-separated list, and both entries are deliberate:
#   - a personal mailbox on an unrelated provider, so an alert still arrives if
#     ryvodigital.com, its DNS or Workspace is the thing that broke
#   - the address actually read every day, so it gets attention
# Survivability and attention are different properties. Do not consolidate
# these to one address for tidiness.
#
# RESIDUAL DEPENDENCY, known and accepted: Resend sends FROM a verified
# ryvodigital.com address, so a DNS failure on that domain can still stop the
# send. Recipient independence covers a mailbox or Workspace failure, not a
# registrar or DNS one.
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@ryvodigital.com
ALERT_EMAIL_TO=
